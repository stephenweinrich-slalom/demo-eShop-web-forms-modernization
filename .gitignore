[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vscode/
*.VisualState.xml
TestResult.xml
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
packages/
!packages/build/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
.nuget/

# MSBuild / build artifacts
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
