# Publish output
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/
*.zip

# Web / IIS
*.[Pp]ublish.xml
Generated_Code/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.rsuser

# ReSharper / Rider / JetBrains
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Local secrets / environment overrides
*.local.env
.env.local
.env.*.local
secrets.json
appsettings.*.local.json
*.pfx
*.key

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Node (front-end tooling, if added)
node_modules/
npm-debug.log*

# Docker local overrides
docker-compose.override.local.yml
